{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "description": "__MSG_extDescription__",
  "author": "Mark Chen",
  "homepage_url": "https://github.com/ZeroMarker/profile-downloader",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.tiktok.com/*",
    "https://instagram.com/*",
    "https://www.instagram.com/*",
    "https://*.instagram.com/*",
    "https://*.twimg.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.fbcdn.net/*",
    "https://onlyfans.com/*",
    "https://*.onlyfans.com/*",
    "https://*.onlyfans.com.cdn.cloudflare.net/*",
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "https://*.sinaimg.cn/*",
    "https://*.weibocdn.com/*",
    "file:///*",
    "https://douyin.com/*",
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.byteimg.com/*",
    "https://kuaishou.com/*",
    "https://*.kuaishou.com/*",
    "https://*.kwaicdn.com/*",
    "https://*.yximgs.com/*",
    "https://*.kwimgs.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "weibo_media_headers",
        "enabled": true,
        "path": "rules/weibo_media_headers.json"
      },
      {
        "id": "douyin_media_headers",
        "enabled": true,
        "path": "rules/douyin_media_headers.json"
      },
      {
        "id": "kuaishou_media_headers",
        "enabled": true,
        "path": "rules/kuaishou_media_headers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://douyin.com/*",
        "https://*.douyin.com/*"
      ],
      "js": [
        "douyin_media_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://weibo.com/*",
        "https://www.weibo.com/*"
      ],
      "js": [
        "weibo_media_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://onlyfans.com/*",
        "https://www.onlyfans.com/*"
      ],
      "js": [
        "onlyfans_media_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "twitter_video_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tiktok_video_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kuaishou.com/*",
        "https://www.kuaishou.com/*"
      ],
      "js": [
        "kuaishou_media_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://instagram.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram_media_interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.tiktok.com/*",
        "https://instagram.com/*",
        "https://www.instagram.com/*",
        "https://onlyfans.com/*",
        "https://www.onlyfans.com/*",
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "file:///*",
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://kuaishou.com/*",
        "https://*.kuaishou.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "wasm/profile_downloader_core.js",
        "wasm/profile_downloader_core_bg.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
